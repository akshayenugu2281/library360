# Copy this file to .env and replace every placeholder before starting the backend.
DB_HOST=localhost
DB_NAME=library360_v3
DB_USER=library360
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
ADMIN_EMAIL=admin@library360.local
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_MIN_6_CHARS_LETTERS_AND_NUMBERS
LIBRARIAN_EMAIL=librarian@library360.local
LIBRARIAN_PASSWORD=REPLACE_WITH_LIBRARIAN_PASSWORD_MIN_6_CHARS_LETTERS_AND_NUMBERS
# Generate using: openssl rand -base64 48  (use a fresh value per environment)
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_SECRET_AT_LEAST_32_DECODED_BYTES
CORS_ORIGINS=http://localhost:5173
# Set true behind HTTPS; false only for local HTTP development.
COOKIE_SECURE=false
# Generate independently using: openssl rand -base64 32
APP_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY
# Optional OpenRouter model ID; Admin may update it through the in-app AI settings.
APP_AI_DEFAULT_MODEL=openai/gpt-4o-mini
