# ==============================================================================
# Library360 Backend Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Aiven MySQL / Ivian MySQL)
# ------------------------------------------------------------------------------
# Fill in the details obtained from your Aiven MySQL Service Overview:
DB_HOST=mysql-xxxxxxxx-your-project.aivencloud.com
DB_PORT=23456
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_aiven_db_password
DB_SSL=true

# (Optional) If you prefer using Aiven's direct JDBC URL instead of individual fields:
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql-xxxx.aivencloud.com:23456/defaultdb?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND CONNECTION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes)
# Include your Vercel URL and local Vite dev server for testing:
CORS_ORIGINS=https://library360-library360upgraded.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. SECURITY & COOKIES (Production / Render)
# ------------------------------------------------------------------------------
# Set true for HTTPS deployments (Render); false only for local HTTP development.
COOKIE_SECURE=true
# Set to 'None' for cross-domain cookies between Vercel and Render (requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=None

# Generate using: openssl rand -base64 48
JWT_SECRET=ZXoIpXA0Hpvqcgzd8JmfNdR57ovFql0cE5+og0NC8WXZGJFbfJaM28x5HzeNijtN

# Generate using: openssl rand -base64 32
APP_SETTINGS_ENCRYPTION_KEY=Qk9zYkFhZ3d4d3h5c2VjcmV0a2V5c2VjdXJlMTIzNDU2Nzg5MA==

# ------------------------------------------------------------------------------
# 4. INITIAL SEED ACCOUNTS
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@library360.local
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_MIN_6_CHARS
LIBRARIAN_EMAIL=librarian@library360.local
LIBRARIAN_PASSWORD=REPLACE_WITH_LIBRARIAN_PASSWORD_MIN_6_CHARS

# ------------------------------------------------------------------------------
# 5. OPTIONAL CONFIGURATIONS
# ------------------------------------------------------------------------------
# Port (automatically set to 10000 on Render, defaults to 8081 locally)
PORT=8081
APP_AI_DEFAULT_MODEL=openai/gpt-4o-mini
